# =============================================================================
# nginx server block — static DevOps marketing site
# =============================================================================
# INSTALL (Ubuntu/Debian, as root or with sudo):
#
#   1. Copy the site into place:
#        mkdir -p /var/www/devops-site
#        rsync -av --delete /path/to/E:/Devops/ /var/www/devops-site/ \
#          --exclude 'Color pallete' --exclude 'serve.js' --exclude 'deploy'
#        chown -R www-data:www-data /var/www/devops-site
#
#   2. Copy this file into place and enable it:
#        cp deploy/nginx.conf.example /etc/nginx/sites-available/devops-site
#        ln -s /etc/nginx/sites-available/devops-site /etc/nginx/sites-enabled/
#        rm -f /etc/nginx/sites-enabled/default
#
#   3. Replace every YOURDOMAIN.COM below, then:
#        nginx -t && systemctl reload nginx
#
#   4. Add TLS (recommended — this also does the HTTP→HTTPS redirect for you):
#        apt install certbot python3-certbot-nginx
#        certbot --nginx -d yourdomain.com -d www.yourdomain.com
# =============================================================================

# --- HTTP: redirect everything to HTTPS once certbot has run. -----------------
server {
    listen 80;
    listen [::]:80;
    server_name YOURDOMAIN.COM www.YOURDOMAIN.COM;

    # Before you have a certificate, comment out the redirect below so the site
    # is at least reachable over plain HTTP.
    # return 301 https://$host$request_uri;
}

# --- HTTPS: the real site -----------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name YOURDOMAIN.COM www.YOURDOMAIN.COM;

    root /var/www/devops-site;
    index index.html;

    # Filled in by certbot:
    # ssl_certificate     /etc/letsencrypt/live/YOURDOMAIN.COM/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/YOURDOMAIN.COM/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # ---------------------------------------------------------------- security
    add_header X-Content-Type-Options   "nosniff"          always;
    add_header X-Frame-Options          "SAMEORIGIN"       always;
    add_header Referrer-Policy          "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy       "geolocation=(), microphone=(), camera=()" always;
    # Enable HSTS only after you are certain HTTPS works and you will not go back.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ------------------------------------------------------------------ gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/javascript
               application/json application/xml image/svg+xml;

    # -------------------------------------------------------------- 404 page
    error_page 404 /404.html;
    location = /404.html { internal; }

    # --------------------------------------------------- long-lived static files
    # Assets are versioned by filename, so cache them hard. Bump the folder name
    # (assets/v2/) if you ever need to force a global refresh.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # HTML must always be revalidated so content edits go live immediately.
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # -------------------------------------------------------------- robots.txt
    location = /robots.txt {
        expires 1d;
        access_log off;
    }

    location = /sitemap.xml {
        expires 1d;
        access_log off;
    }

    # ------------------------------------------------------------------ routes
    location / {
        try_files $uri $uri/ $uri.html =404;
    }
}
