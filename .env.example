# ---------------------------------------------------------------------------
# Copy to .env and fill in what you need. Everything here is optional for
# local development — the site renders without any of it, and the contact
# form falls back to writing submissions to disk when SMTP is not configured.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
PORT=3000
# Bind address. Use 127.0.0.1 in production so the app is only reachable
# through nginx and the port is never exposed to the internet.
HOST=0.0.0.0

# --- contact form email (optional) ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=

# --- contact form webhook (optional) ----------------------------------------
# Fired as a JSON POST on every submission. Slack / Discord / n8n / Zapier all work.
CONTACT_WEBHOOK_URL=

# --- storage ----------------------------------------------------------------
# Where the JSONL fallback store lives. Keep this outside the deploy target so
# a deploy cannot delete visitor submissions.
SUBMISSIONS_DIR=server/data

# --- debugging --------------------------------------------------------------
# Log `status url "title"` for every server render.
LOG_RENDERS=
